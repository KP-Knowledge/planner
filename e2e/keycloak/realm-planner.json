{
  "realm": "planner",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "planner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "planner-e2e-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    }
  ],
  "users": [
    {
      "username": "e2e",
      "enabled": true,
      "email": "e2e@example.com",
      "emailVerified": true,
      "firstName": "E2E",
      "lastName": "Tester",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "e2e-password", "temporary": false }
      ]
    }
  ]
}
